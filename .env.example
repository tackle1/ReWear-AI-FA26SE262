# API Configuration
# Để TRỐNG để axios gọi URL tương đối và đi qua proxy của Vite dev server
# (xem `server.proxy` trong vite.config.ts) — tránh lỗi chứng chỉ HTTPS self-signed.
# Backend .NET chạy ở https://localhost:7289
# VITE_API_BASE_URL=
VITE_WS_URL=ws://localhost:8000/ws

# Không còn cờ bật/tắt mock: luồng đăng ký & đng nhập LUÔN gọi API thật của
# backend .NET. Endpoint đang dùng (xem `server.proxy` trong vite.config.ts,
# đổi `target` nếu backend chạy cổng khác):
#   POST /api/Auth/register
#   POST /api/Auth/login
#   POST /api/ListingsExample/create?userId={guid}
#   GET  /api/ListingsExample/premium-brands
#   GET  /api/ListingsExample/thresholds

# VietQR Configuration
VITE_VIETQR_CLIENT_ID=
VITE_VIETQR_API_KEY=

# Application Environment
VITE_APP_ENV=development
