# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Backend danh sách thương hiệu bảo chứng (.NET, HTTPS self-signed).
# Gọi qua proxy của Vite dev server nên không cần khai báo ở đây.
# Xem `server.proxy` trong vite.config.ts — thay đổi target nếu backend chạy cổng khác.

# VietQR Configuration
VITE_VIETQR_CLIENT_ID=
VITE_VIETQR_API_KEY=

# Application Environment
VITE_APP_ENV=development
